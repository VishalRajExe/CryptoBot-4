# Cryptobot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Cryptobot
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PAPER_TRADING=true
DEFAULT_EXCHANGE=binance
DEFAULT_TIMEFRAME=1h
LOOKBACK_BARS=500

# Data directories
DATA_DIR=./data
RESULTS_DIR=./results

# =============================================================================
# EXCHANGE API KEYS
# Set these for live trading (paper trading works without them)
# =============================================================================

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Hyperliquid
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
HYPERLIQUID_VAULT_ADDRESS=

# Deribit
DERIBIT_API_KEY=
DERIBIT_API_SECRET=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Alpaca (Paper Trading - Pre-configured)
ALPACA_API_KEY=PKP753ICW5ZTKXS3KWXUT6P2P3
ALPACA_API_SECRET=E6EPPR8sLqqHJGEdMncagQYyfQ9CbpnuWhdTF6x4HhY6

# =============================================================================
# LLM PROVIDER KEYS (for research agents)
# Set at least one for AI research capabilities
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# TELEGRAM BOT (for notifications)
# =============================================================================
TELEGRAM_BOT_TOKEN=8806462517:AAETi5VjAhbHnWdkL8DzoXdYfyYYu7fihPQ
TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# DATA SOURCES (optional)
# =============================================================================
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_PCT=0.80
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
MAX_LEVERAGE=3.0
MIN_RISK_REWARD=1.5
KELLY_FRACTION=0.25

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///./data/cryptobot.db

# =============================================================================
# REDIS (optional, for L2 cache)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# TELEGRAM NOTIFICATIONS
# =============================================================================
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFICATIONS_TRADE_OPENED=true
TELEGRAM_NOTIFICATIONS_TRADE_CLOSED=true
TELEGRAM_NOTIFICATIONS_RISK_ALERT=true
TELEGRAM_NOTIFICATIONS_RESEARCH_COMPLETED=true
TELEGRAM_NOTIFICATIONS_BACKTEST_COMPLETED=true
TELEGRAM_NOTIFICATIONS_SYSTEM_ALERT=true
TELEGRAM_NOTIFICATIONS_DAILY_SUMMARY=true

# =============================================================================
# DASHBOARD
# =============================================================================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_WS_PORT=8081
DASHBOARD_AUTH_ENABLED=false